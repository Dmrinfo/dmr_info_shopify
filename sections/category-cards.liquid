{%- comment -%}
  ============================================================
  category-cards — grade de cards de categoria
  ============================================================

  O QUE FAZ:
  Exibe categorias da loja (ex.: CFTV, alarmes, redes, informática)
  como cards clicáveis com imagem ou ícone, título e descrição curta.

  COMO USAR:
  Adicione "Categorias com cards" na home e inclua blocos "Categoria".
  Máximo de 8 categorias.

  PARÂMETROS (schema):
  - eyebrow, heading: texto acima da grade.
  - columns_desktop: 2 a 4 colunas.
  - Bloco category: image, icon, title, text, link.

  OBSERVACOES:
  Sem imagem, o card mostra o ícone escolhido sobre fundo Alice Blue.
  Estilo no <style> abaixo, escopado por .category-cards.
{%- endcomment -%}
<section class="category-cards page-width" style="--cc-columns: {{ section.settings.columns_desktop }};">
  {%- if section.settings.eyebrow != blank -%}
    <span class="dmr-eyebrow">{{ section.settings.eyebrow | escape }}</span>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="category-cards__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <ul class="category-cards__grid" role="list">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        <a class="category-cards__card" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}>
          <span class="category-cards__media">
            {%- if block.settings.image != blank -%}
              {%- assign img_alt = block.settings.title -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 1000px) 25vw, 50vw', alt: img_alt }}
            {%- else -%}
              <span class="category-cards__icon" aria-hidden="true">
                {% render 'category-icon', name: block.settings.icon %}
              </span>
            {%- endif -%}
          </span>
          <span class="category-cards__body">
            <span class="category-cards__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.text != blank -%}
              <span class="category-cards__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </span>
          <span class="category-cards__arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 13 13 1M13 1H3M13 1v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

<style>
  .category-cards { padding-top: var(--spacing-sections); padding-bottom: var(--spacing-sections); }
  .category-cards__heading { margin: 16px 0 32px; }
  .category-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--cc-columns, 4), 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .category-cards__card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: var(--dmr-eerie-black);
    text-decoration: none;
    background: var(--dmr-alice-blue);
    border: 1px solid var(--dmr-azureish-white);
    border-radius: var(--dmr-radius-card);
    transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }
  .category-cards__card:hover {
    border-color: var(--dmr-diamond);
    box-shadow: var(--dmr-shadow-hover);
    transform: translateY(-4px);
  }
  .category-cards__media {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    background: linear-gradient(160deg, #fff, var(--dmr-alice-blue));
  }
  .category-cards__media img { width: 100%; height: 100%; object-fit: cover; }
  .category-cards__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    color: var(--dmr-primary);
    background: #fff;
    border: 1px solid var(--dmr-azureish-white);
    border-radius: var(--dmr-radius-pill);
  }
  .category-cards__icon svg { width: 40px; height: 40px; }
  .category-cards__body { display: flex; flex-direction: column; gap: 6px; padding: 20px 24px 24px; }
  .category-cards__title { font-family: var(--font-heading-family); font-size: var(--f4); letter-spacing: var(--dmr-title-tracking); }
  .category-cards__text { font-size: var(--f1); line-height: 1.5; color: var(--dmr-independence); }
  .category-cards__arrow {
    position: absolute;
    top: 16px;
    right: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--dmr-primary);
    background: #fff;
    border-radius: var(--dmr-radius-pill);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .category-cards__card:hover .category-cards__arrow { color: #fff; background: var(--dmr-primary); }

  @media screen and (max-width: 1000px) {
    .category-cards__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .category-cards__body { padding: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .category-cards__card { transition: none; }
    .category-cards__card:hover { transform: none; }
  }
</style>

{% schema %}
{
  "name": "Categorias com cards",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Categorias" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Encontre o que sua empresa precisa" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Colunas no desktop", "default": 4 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem", "info": "Opcional. Sem imagem, o card usa o ícone." },
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "default": "camera",
          "options": [
            { "value": "shield", "label": "Escudo (segurança)" },
            { "value": "wifi", "label": "Wi-Fi (redes)" },
            { "value": "phone", "label": "Telefone (comunicação)" },
            { "value": "keypad", "label": "Teclado (controle de acesso)" },
            { "value": "bolt", "label": "Raio (energia)" },
            { "value": "solar", "label": "Sol e raio (energia solar)" },
            { "value": "home", "label": "Casa (casa inteligente)" },
            { "value": "computer", "label": "Computador (informática)" },
            { "value": "camera", "label": "Câmera" },
            { "value": "lock", "label": "Cadeado" },
            { "value": "network", "label": "Rede" },
            { "value": "recorder", "label": "Gravador (DVR/NVR)" },
            { "value": "alarm", "label": "Alarme" },
            { "value": "fence", "label": "Cerca elétrica" },
            { "value": "intercom", "label": "Interfone" }
          ]
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Categoria" },
        { "type": "text", "id": "text", "label": "Descrição curta" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorias com cards",
      "blocks": [
        { "type": "category", "settings": { "icon": "camera", "title": "Câmeras e CFTV" } },
        { "type": "category", "settings": { "icon": "shield", "title": "Alarmes e sensores" } },
        { "type": "category", "settings": { "icon": "network", "title": "Redes e Wi-Fi" } },
        { "type": "category", "settings": { "icon": "computer", "title": "Informática" } }
      ]
    }
  ]
}
{% endschema %}
