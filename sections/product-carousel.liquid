{%- comment -%}
  ============================================================
  product-carousel — vitrine com abas e carrossel de produtos
  ============================================================

  O QUE FAZ:
  Abas no topo (ex.: "Mais vendidos", "Ofertas do dia",
  "Lançamentos"), cada uma mostrando os produtos de uma coleção num
  carrossel com setas e bolinhas, usando o mesmo card da loja
  (snippets/card-product.liquid, com preço PIX e botões no hover).

  COMO USAR:
  Adicione "Carrossel de produtos" na home e inclua blocos "Aba",
  escolhendo a coleção de cada uma.

  PARÂMETROS (schema):
  - heading: título opcional acima das abas.
  - products_to_show: produtos por aba (4 a 24).
  - Bloco tab: label, collection.

  OBSERVACOES:
  Aba sem coleção ou com coleção vazia não aparece. Se nenhuma aba
  tiver produtos, mostra os produtos da loja (coleção "all").
  Carrossel por scroll-snap; setas, bolinhas e troca de aba em
  assets/product-carousel.js. A faixa tem respiro embaixo para os
  botões do hover dos cards não serem cortados.
{%- endcomment -%}
{{ 'product-carousel.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Coleção de cada aba: a escolhida no bloco; se vazia, a de handle igual
  ao nome da aba ("Mais vendidos" -> mais-vendidos). Assim a aba funciona
  mesmo quando a coleção foi criada depois de a seção ser configurada.
  Aba só conta se a coleção tiver produtos (products.size).
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.products_to_show
  assign tab_count = 0
  for block in section.blocks
    assign tab_collection = block.settings.collection
    if tab_collection == blank
      assign tab_handle = block.settings.label | handleize
      assign tab_collection = collections[tab_handle]
    endif
    if tab_collection != blank and tab_collection.products.size > 0
      assign tab_count = tab_count | plus: 1
    endif
  endfor
  assign prev_label = 'sections.product_carousel.previous' | t
  assign next_label = 'sections.product_carousel.next' | t
  assign region_label = section.settings.heading | default: 'Produtos'
  assign dot_label = 'sections.product_carousel.page' | t
-%}

{%- comment -%} Controles (setas + bolinhas geradas pelo JS), iguais em todo painel {%- endcomment -%}
{%- capture carousel_controls -%}
  <div class="product-carousel__controls" data-carousel-controls>
    <button type="button" class="product-carousel__arrow product-carousel__arrow--prev" data-carousel-prev aria-label="{{ prev_label | escape }}" disabled>
      {% render 'icon', name: 'chevron-right', class: 'product-carousel__arrow-icon' %}
    </button>
    <div class="product-carousel__dots" data-carousel-dots data-dot-label="{{ dot_label | escape }}"></div>
    <button type="button" class="product-carousel__arrow product-carousel__arrow--next" data-carousel-next aria-label="{{ next_label | escape }}">
      {% render 'icon', name: 'chevron-right', class: 'product-carousel__arrow-icon' %}
    </button>
  </div>
{%- endcapture -%}

<section class="product-carousel page-width" data-product-carousel aria-label="{{ region_label | escape }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="product-carousel__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if tab_count > 0 -%}
    {%- if tab_count > 1 -%}
      <div class="product-carousel__tabs" role="tablist">
        {%- assign first_done = false -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign tab_collection = block.settings.collection
            if tab_collection == blank
              assign tab_handle = block.settings.label | handleize
              assign tab_collection = collections[tab_handle]
            endif
          -%}
          {%- if tab_collection != blank and tab_collection.products.size > 0 -%}
            <button
              type="button"
              class="product-carousel__tab"
              role="tab"
              id="Tab-{{ section.id }}-{{ block.id }}"
              aria-controls="Panel-{{ section.id }}-{{ block.id }}"
              aria-selected="{% if first_done %}false{% else %}true{% endif %}"
              {% if first_done %}tabindex="-1"{% endif %}
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | default: tab_collection.title | escape -}}
            </button>
            {%- assign first_done = true -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign first_done = false -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign tab_collection = block.settings.collection
        if tab_collection == blank
          assign tab_handle = block.settings.label | handleize
          assign tab_collection = collections[tab_handle]
        endif
      -%}
      {%- if tab_collection != blank and tab_collection.products.size > 0 -%}
        <div
          class="product-carousel__panel"
          id="Panel-{{ section.id }}-{{ block.id }}"
          {% if tab_count > 1 %}role="tabpanel" aria-labelledby="Tab-{{ section.id }}-{{ block.id }}"{% endif %}
          {% if first_done %}hidden{% endif %}
          data-carousel-panel
        >
          <ul class="product-carousel__track" role="list" data-carousel-track>
            {%- for product in tab_collection.products limit: limit -%}
              <li class="product-carousel__item">{% render 'card-product', card_product: product %}</li>
            {%- endfor -%}
          </ul>
          {{ carousel_controls }}
        </div>
        {%- assign first_done = true -%}
      {%- endif -%}
    {%- endfor -%}
  {%- elsif collections.all.products.size > 0 -%}
    <div class="product-carousel__panel" data-carousel-panel>
      <ul class="product-carousel__track" role="list" data-carousel-track>
        {%- for product in collections.all.products limit: limit -%}
          <li class="product-carousel__item">{% render 'card-product', card_product: product %}</li>
        {%- endfor -%}
      </ul>
      {{ carousel_controls }}
    </div>
  {%- elsif request.design_mode -%}
    <p class="product-carousel__empty">{{ 'sections.product_carousel.empty' | t }}</p>
  {%- endif -%}
</section>

<script src="{{ 'product-carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Carrossel de produtos",
  "tag": "div",
  "class": "section-product-carousel",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "info": "Opcional." },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 24, "step": 1, "label": "Produtos por aba", "default": 12 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Aba",
      "settings": [
        { "type": "text", "id": "label", "label": "Nome da aba", "default": "Mais vendidos" },
        { "type": "collection", "id": "collection", "label": "Coleção", "info": "Para \"Mais vendidos\", use uma coleção com ordenação \"Mais vendidos\"." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carrossel de produtos",
      "blocks": [
        { "type": "tab", "settings": { "label": "Mais vendidos" } },
        { "type": "tab", "settings": { "label": "Ofertas do dia" } },
        { "type": "tab", "settings": { "label": "Lançamentos" } }
      ]
    }
  ]
}
{% endschema %}
