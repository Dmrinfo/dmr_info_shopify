{%- comment -%}
  ============================================================
  MAIN COLLECTION — produtos da coleção com filtros laterais
  ============================================================

  O QUE FAZ:
  - Menu lateral de filtros (collection.filters, configurados no app
    Search & Discovery): sanfonas com checkboxes e faixa de preço com
    controle deslizante. Aplica ao marcar (assets/collection.js).
  - Barra com total de resultados e ordenação.
  - Filtros ativos como etiquetas removíveis.
  - Grade de produtos (snippet 'card-product') e paginação.
  - No mobile (<= 1000px) os filtros viram uma gaveta lateral.

  ONDE É USADA:
  templates/collection.json.

  OBSERVAÇÕES:
  - Funciona sem JavaScript (formulários GET + botão "Aplicar").
  - Valores de preço vêm em centavos; os campos usam reais
    (divided_by: 100.0).
  - Estilos em assets/collection.css.
{%- endcomment -%}
{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign show_filters = true
  endif

  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor

  assign clear_url = collection.url
  if collection.sort_by != blank
    assign clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
  endif
-%}

{%- paginate collection.products by section.settings.products_per_page -%}
  <div
    class="collection page-width{% if show_filters %} collection--with-facets{% endif %}"
    style="--grid-columns: {{ section.settings.columns_desktop }};"
    data-collection
  >
    {%- if show_filters -%}
      <div class="facets-overlay" data-facets-close hidden></div>
      <aside class="facets" id="Facets-{{ section.id }}" aria-labelledby="FacetsTitle-{{ section.id }}" data-facets>
        <div class="facets__header">
          <h2 class="facets__title" id="FacetsTitle-{{ section.id }}">{{ 'products.facets.title' | t }}</h2>
          <button type="button" class="facets__close" aria-label="{{ 'accessibility.close' | t }}" data-facets-close>
            {% render 'icon', name: 'close' %}
          </button>
        </div>

        <form method="get" action="{{ collection.url }}" class="facets__form" data-facets-form>
          {%- if collection.sort_by != blank -%}
            <input type="hidden" name="sort_by" value="{{ collection.sort_by | escape }}">
          {%- endif -%}

          {%- for filter in collection.filters -%}
            {%- liquid
              assign is_open = false
              if filter.active_values.size > 0
                assign is_open = true
              endif
              if filter.type == 'price_range'
                if filter.min_value.value != nil or filter.max_value.value != nil
                  assign is_open = true
                endif
              endif
            -%}
            <details class="facets__group"{% if is_open %} open{% endif %}>
              <summary class="facets__summary">
                <span>{{ filter.label | escape }}</span>
                {%- if filter.active_values.size > 0 -%}
                  <span class="facets__badge">{{ filter.active_values.size }}</span>
                {%- endif -%}
                <svg class="facets__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>

              <div class="facets__content">
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    <ul class="facets__list" role="list">
                      {%- for value in filter.values -%}
                        {%- assign value_id = 'Filter-' | append: section.id | append: '-' | append: forloop.parentloop.index | append: '-' | append: forloop.index -%}
                        {%- assign is_disabled = false -%}
                        {%- if value.count == 0 and value.active == false -%}{%- assign is_disabled = true -%}{%- endif -%}
                        <li>
                          <label class="facets__option{% if is_disabled %} is-disabled{% endif %}" for="{{ value_id }}">
                            <input
                              type="checkbox"
                              id="{{ value_id }}"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                              {% if is_disabled %}disabled{% endif %}
                            >
                            <span class="facets__checkbox" aria-hidden="true"></span>
                            <span class="facets__label">{{ value.label | escape }}</span>
                            <span class="facets__count">{{ value.count }}</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>

                  {%- when 'price_range' -%}
                    {%- liquid
                      assign range_max = filter.range_max | divided_by: 100.0 | ceil
                      assign current_min = 0
                      assign current_max = range_max
                      if filter.min_value.value != nil
                        assign current_min = filter.min_value.value | divided_by: 100.0 | floor
                      endif
                      if filter.max_value.value != nil
                        assign current_max = filter.max_value.value | divided_by: 100.0 | ceil
                      endif
                      assign label_min = current_min | times: 100 | money
                      assign label_max = current_max | times: 100 | money
                    -%}
                    <div
                      class="facets__price"
                      data-price-range
                      data-currency="{{ cart.currency.iso_code }}"
                      data-locale="{{ request.locale.iso_code }}"
                    >
                      <div class="facets__range">
                        <div class="facets__range-track"><span class="facets__range-fill" data-range-fill></span></div>
                        <input
                          class="facets__range-input"
                          type="range"
                          min="0"
                          max="{{ range_max }}"
                          step="1"
                          value="{{ current_min }}"
                          aria-label="{{ 'products.facets.price_min' | t }}"
                          data-range-min
                        >
                        <input
                          class="facets__range-input"
                          type="range"
                          min="0"
                          max="{{ range_max }}"
                          step="1"
                          value="{{ current_max }}"
                          aria-label="{{ 'products.facets.price_max' | t }}"
                          data-range-max
                        >
                      </div>
                      <div class="facets__price-labels">
                        <span data-label-min>{{ label_min }}</span>
                        <span data-label-max>{{ label_max }}</span>
                      </div>
                      <div class="facets__price-fields">
                        <label class="facets__price-field">
                          <span class="field__label">{{ 'products.facets.from' | t }}</span>
                          <input
                            class="field__input"
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            min="0"
                            max="{{ range_max }}"
                            placeholder="0"
                            {% if filter.min_value.value != nil %}value="{{ current_min }}"{% endif %}
                            data-input-min
                          >
                        </label>
                        <label class="facets__price-field">
                          <span class="field__label">{{ 'products.facets.to' | t }}</span>
                          <input
                            class="field__input"
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            min="0"
                            max="{{ range_max }}"
                            placeholder="{{ range_max }}"
                            {% if filter.max_value.value != nil %}value="{{ current_max }}"{% endif %}
                            data-input-max
                          >
                        </label>
                      </div>
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}

          <div class="facets__actions">
            <button type="submit" class="button facets__apply">{{ 'products.facets.apply' | t }}</button>
            {%- if active_count > 0 -%}
              <a class="facets__clear" href="{{ clear_url }}">{{ 'products.facets.clear_all' | t }}</a>
            {%- endif -%}
          </div>
        </form>
      </aside>
    {%- elsif section.settings.enable_filtering and request.design_mode -%}
      <p class="collection__hint">{{ 'products.facets.setup_hint' | t }}</p>
    {%- endif -%}

    <div class="collection__main">
      <div class="collection__toolbar">
        {%- if show_filters -%}
          <button
            type="button"
            class="collection__filter-toggle"
            aria-controls="Facets-{{ section.id }}"
            aria-expanded="false"
            data-facets-open
          >
            <svg class="collection__filter-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span>{{ 'products.facets.filter_button' | t }}</span>
            {%- if active_count > 0 -%}<span class="facets__badge">{{ active_count }}</span>{%- endif -%}
          </button>
        {%- endif -%}

        <p class="collection__count">{{ 'products.facets.results_count' | t: count: collection.products_count }}</p>

        {%- if section.settings.enable_sorting -%}
          <form method="get" action="{{ collection.url }}" class="collection__sort">
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
              {%- endfor -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != nil -%}
                  <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100.0 }}">
                {%- endif -%}
                {%- if filter.max_value.value != nil -%}
                  <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100.0 }}">
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            <label class="visually-hidden" for="SortBy-{{ section.id }}">{{ 'products.facets.sort_by_label' | t }}</label>
            <div class="collection__select">
              <select name="sort_by" id="SortBy-{{ section.id }}" class="collection__sort-select" data-sort-select>
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>
                    {{- option.name -}}
                  </option>
                {%- endfor -%}
              </select>
              <svg class="collection__select-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <noscript>
              <button type="submit" class="button button--secondary">{{ 'products.facets.apply' | t }}</button>
            </noscript>
          </form>
        {%- endif -%}
      </div>

      {%- if active_count > 0 -%}
        <div class="collection__active">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a class="collection__chip" href="{{ value.url_to_remove }}">
                {{- value.label | escape -}}
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <span class="visually-hidden">{{ 'products.facets.remove_filter' | t }}</span>
              </a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                {%- assign chip_min = filter.min_value.value | default: 0 | money -%}
                {%- assign chip_max = filter.max_value.value | default: filter.range_max | money -%}
                <a class="collection__chip" href="{{ filter.url_to_remove }}">
                  {{- chip_min }} – {{ chip_max -}}
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  <span class="visually-hidden">{{ 'products.facets.remove_filter' | t }}</span>
                </a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <a class="collection__clear" href="{{ clear_url }}">{{ 'products.facets.clear_all' | t }}</a>
        </div>
      {%- endif -%}

      {%- if collection.products.size == 0 -%}
        <div class="collection__empty">
          <p>{{ 'sections.main_collection.empty' | t }}</p>
          {%- if active_count > 0 -%}
            <a href="{{ clear_url }}" class="button button--secondary">{{ 'sections.main_collection.use_fewer_filters' | t }}</a>
          {%- else -%}
            <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">{{ 'general.continue_shopping' | t }}</a>
          {%- endif -%}
        </div>
      {%- else -%}
        <ul class="product-grid" role="list">
          {%- for product in collection.products -%}
            <li class="product-grid__item">
              {% render 'card-product', card_product: product %}
            </li>
          {%- endfor -%}
        </ul>

        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

<script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 24,
      "label": "t:sections.main_collection.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:sections.main_collection.settings.columns_desktop.label"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main_collection.settings.enable_sorting.label"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main_collection.settings.enable_filtering.label",
      "info": "Os filtros são configurados no app Search & Discovery da Shopify."
    }
  ]
}
{% endschema %}
