{%- comment -%}
  ============================================================
  main-account — página "Minha conta" (customers/account)
  ============================================================

  O QUE FAZ:
  Saudação, botão de sair, histórico de pedidos (paginado, 20 por
  página) e resumo com dados do cliente e endereço principal.

  OBSERVACOES:
  Só é usado com contas de cliente clássicas.
{%- endcomment -%}
{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- assign customer_name = customer.first_name | default: customer.email -%}
<section class="customer page-width">
  <div class="customer__head">
    <div>
      <h1 class="customer__title">{{ 'customer.account.title' | t }}</h1>
      <p class="customer__lead">{{ 'customer.account.greeting' | t: name: customer_name }}</p>
    </div>
    <a class="button button--secondary" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
  </div>

  <div class="customer__grid">
    <div class="customer__card">
      <h2 class="customer__section-title">{{ 'customer.orders.title' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="customer__table customer__table--responsive">
            <thead>
              <tr>
                <th scope="col">{{ 'customer.orders.order_number' | t }}</th>
                <th scope="col">{{ 'customer.orders.date' | t }}</th>
                <th scope="col">{{ 'customer.orders.payment_status' | t }}</th>
                <th scope="col">{{ 'customer.orders.fulfillment_status' | t }}</th>
                <th scope="col" class="is-right">{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td data-label="{{ 'customer.orders.order_number' | t }}">
                    <a href="{{ order.customer_url }}" aria-label="{{ 'customer.orders.view' | t }} {{ order.name }}">{{ order.name }}</a>
                  </td>
                  <td data-label="{{ 'customer.orders.date' | t }}">{{ order.created_at | date: '%d/%m/%Y' }}</td>
                  <td data-label="{{ 'customer.orders.payment_status' | t }}"><span class="customer__badge">{{ order.financial_status_label }}</span></td>
                  <td data-label="{{ 'customer.orders.fulfillment_status' | t }}"><span class="customer__badge">{{ order.fulfillment_status_label }}</span></td>
                  <td data-label="{{ 'customer.orders.total' | t }}" class="is-right">{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="customer__empty">
            <p>{{ 'customer.account.orders_empty' | t }}</p>
            <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'customer.account.start_shopping' | t }}</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    <aside class="customer__card">
      <h2 class="customer__section-title">{{ 'customer.account.details' | t }}</h2>
      <p class="customer__meta">
        {{ customer.name | escape }}<br>
        {{ customer.email | escape }}
      </p>

      <h3 class="customer__subheading">{{ 'customer.account.default_address' | t }}</h3>
      {%- if customer.default_address -%}
        <address class="customer__address">{{ customer.default_address | format_address }}</address>
      {%- else -%}
        <p class="customer__meta">{{ 'customer.account.no_address' | t }}</p>
      {%- endif -%}

      <div class="customer__links customer__links--start">
        <a class="customer__link" href="{{ routes.account_addresses_url }}">
          {{- 'customer.account.manage_addresses' | t: count: customer.addresses_count -}}
        </a>
      </div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Minha conta",
  "settings": []
}
{% endschema %}
