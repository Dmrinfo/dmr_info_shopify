{%- comment -%}
  ============================================================
  testimonials — depoimentos de clientes
  ============================================================

  O QUE FAZ:
  Exibe depoimentos em cards, com texto, nome, cargo/empresa e
  nota de 1 a 5 estrelas.

  COMO USAR:
  Adicione "Depoimentos" na home e inclua blocos "Depoimento".
  Máximo de 6.

  PARÂMETROS (schema):
  - eyebrow, heading: texto acima da grade.
  - Bloco testimonial: text, author, role, rating.

  OBSERVACOES:
  Use só depoimentos reais e autorizados pelos clientes.
  Estilo no <style> abaixo, escopado por .testimonials.
{%- endcomment -%}
<section class="testimonials page-width">
  {%- if section.settings.eyebrow != blank -%}
    <span class="dmr-eyebrow">{{ section.settings.eyebrow | escape }}</span>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="testimonials__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <ul class="testimonials__grid" role="list">
    {%- for block in section.blocks -%}
      <li class="testimonials__card" {{ block.shopify_attributes }}>
        <figure class="testimonials__figure">
          <span class="testimonials__stars" role="img" aria-label="{{ block.settings.rating }} / 5">
            {%- for i in (1..5) -%}
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="{% if i <= block.settings.rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>
            {%- endfor -%}
          </span>
          <blockquote class="testimonials__quote">{{ block.settings.text | escape }}</blockquote>
          <figcaption class="testimonials__author">
            <strong>{{ block.settings.author | escape }}</strong>
            {%- if block.settings.role != blank -%}<span>{{ block.settings.role | escape }}</span>{%- endif -%}
          </figcaption>
        </figure>
      </li>
    {%- endfor -%}
  </ul>
</section>

<style>
  .testimonials { padding-top: var(--spacing-sections); padding-bottom: var(--spacing-sections); }
  .testimonials__heading { margin: 16px 0 32px; }
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .testimonials__card {
    padding: 28px;
    background: var(--dmr-alice-blue);
    border: 1px solid var(--dmr-azureish-white);
    border-radius: var(--dmr-radius-card);
  }
  .testimonials__figure { display: flex; flex-direction: column; gap: 16px; height: 100%; margin: 0; }
  .testimonials__stars { display: inline-flex; gap: 2px; color: var(--dmr-primary); }
  .testimonials__quote { flex: 1; margin: 0; font-size: var(--f3); line-height: 1.5; color: var(--dmr-eerie-black); }
  .testimonials__author { display: flex; flex-direction: column; gap: 2px; font-size: var(--f1); color: var(--dmr-independence); }
  .testimonials__author strong { font-weight: 600; color: var(--dmr-eerie-black); }
</style>

{% schema %}
{
  "name": "Depoimentos",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Clientes" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Quem usa, recomenda" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Depoimento",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Depoimento", "default": "Escreva aqui o depoimento real de um cliente." },
        { "type": "text", "id": "author", "label": "Nome", "default": "Nome do cliente" },
        { "type": "text", "id": "role", "label": "Cargo ou empresa" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Nota", "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Depoimentos",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
