{%- comment -%}
  ============================================================
  NAV / HEADER — cabeçalho do site
  ============================================================

  O QUE FAZ:
  Monta o cabeçalho da loja em duas faixas:
  1. Linha principal: logo, busca em pílula, atendimento,
     acessibilidade, CEP, conta ("Olá, Bem-Vindo! / Entrar") e
     carrinho com contador.
  2. Barra de categorias: botão "Todas categorias" (painel com
     ícones) e links de categoria.
  Inclui menu mobile (hambúrguer) e seletores de localização.

  ONDE É USADA:
  No layout (layout/theme.liquid), via section group header-group.

  PRINCIPAIS PARTES:
  - Logo: settings.logo ou, se vazio, assets/logo-dmr.svg.
  - Busca: formulário GET para routes.search_url (sempre visível).
  - Atendimento: link (support_link, padrão /pages/contato).
  - Acessibilidade: popover com tamanho de fonte e alto contraste.
  - CEP: popover que salva o CEP no navegador e mostra no header.
    Não calcula frete.
  - Conta: só se customer_accounts_enabled; mostra o nome do
    cliente logado.
  - Carrinho: contador [data-cart-count] (atualizado por carrinho.js).
  - header__mobile-nav: menu (setting menu) para telas <= 1000px.
  - category-bar: blocos 'panel_item' (painel com ícones), 'link'
    (com negrito opcional) e 'divider'.

  OBSERVAÇÕES:
  - CSS: assets/header.css e assets/category-bar.css.
  - JS: assets/header.js (menu mobile, popovers, CEP, acessibilidade).
  - Ícones: snippets 'icon' e 'category-icon'.
{%- endcomment -%}
{{ 'header.css' | asset_url | stylesheet_tag }}

<header class="header page-width" data-header data-section-id="{{ section.id }}">
  <div class="header__inner">
    <button
      type="button"
      class="header__menu-toggle tap-target"
      aria-label="{{ 'sections.header.menu' | t }}"
      aria-expanded="false"
      aria-controls="MobileNav-{{ section.id }}"
    >
      <span class="header__burger"></span>
    </button>

    <a href="{{ routes.root_url }}" class="header__logo-link">
      {%- if settings.logo != blank -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio | round -%}
        {%- assign logo_alt = shop.name -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'header__logo-image',
            widths: '150, 300, 450, 600',
            width: settings.logo_width,
            height: logo_height,
            alt: logo_alt,
            sizes: '(max-width: 1000px) 40vw, 200px'
        }}
      {%- else -%}
        <img
          class="header__logo-image"
          src="{{ 'logo-dmr.svg' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="{{ settings.logo_width }}"
          height="{{ settings.logo_width | divided_by: 3.121 | round }}"
        >
      {%- endif -%}
    </a>

    <form action="{{ routes.search_url }}" method="get" role="search" class="header__search">
      <label for="HeaderSearch-{{ section.id }}" class="visually-hidden">{{ 'general.search.search' | t }}</label>
      <input
        id="HeaderSearch-{{ section.id }}"
        class="header__search-input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'sections.header.search_placeholder' | t }}"
        autocomplete="off"
      >
      <button type="submit" class="header__search-submit" aria-label="{{ 'general.search.submit' | t }}">
        {% render 'icon', name: 'search' %}
      </button>
    </form>

    <div class="header__actions">
      {%- if section.settings.show_support -%}
        {%- assign support_url = section.settings.support_link | default: '/pages/contato' -%}
        <a
          href="{{ support_url }}"
          class="header__round-button header__support"
          aria-label="{{ 'sections.header.support' | t }}"
          title="{{ 'sections.header.support' | t }}"
        >
          {% render 'icon', name: 'headset' %}
        </a>
      {%- endif -%}

      {%- if section.settings.show_accessibility -%}
        <details class="header__popover-host header__a11y" data-popover data-a11y>
          <summary
            class="header__round-button"
            aria-label="{{ 'sections.header.accessibility' | t }}"
            title="{{ 'sections.header.accessibility' | t }}"
          >
            {% render 'icon', name: 'accessibility' %}
          </summary>
          <div class="header__popover">
            <p class="header__popover-title">{{ 'sections.header.accessibility' | t }}</p>
            <div class="header__a11y-row">
              <button type="button" class="header__a11y-button" data-a11y-font="down" aria-label="{{ 'sections.header.font_decrease' | t }}">A−</button>
              <button type="button" class="header__a11y-button" data-a11y-font="reset" aria-label="{{ 'sections.header.font_reset' | t }}">A</button>
              <button type="button" class="header__a11y-button" data-a11y-font="up" aria-label="{{ 'sections.header.font_increase' | t }}">A+</button>
            </div>
            <button type="button" class="header__a11y-toggle" data-a11y-contrast aria-pressed="false">
              {{- 'sections.header.high_contrast' | t -}}
            </button>
          </div>
        </details>
      {%- endif -%}

      {%- if section.settings.show_cep -%}
        <details
          class="header__popover-host header__cep"
          data-popover
          data-cep
          data-cep-template="{{ 'sections.header.cep_saved' | t: cep: '__CEP__' | escape }}"
        >
          <summary class="header__info" aria-label="{{ 'sections.header.cep_label' | t }}">
            <span class="header__info-icon">{% render 'icon', name: 'pin' %}</span>
            <span class="header__info-text">
              <span class="header__info-label" data-cep-label>{{ 'sections.header.cep_label' | t }}</span>
              <span class="header__info-action">{{ 'sections.header.cep_change' | t }} {% render 'icon', name: 'chevron' %}</span>
            </span>
          </summary>
          <div class="header__popover">
            <form class="header__cep-form" data-cep-form novalidate>
              <label for="HeaderCep-{{ section.id }}" class="header__popover-title">{{ 'sections.header.cep_title' | t }}</label>
              <div class="header__cep-row">
                <input
                  id="HeaderCep-{{ section.id }}"
                  class="field__input"
                  type="text"
                  inputmode="numeric"
                  autocomplete="postal-code"
                  maxlength="9"
                  placeholder="00000-000"
                  aria-describedby="HeaderCepError-{{ section.id }}"
                  data-cep-input
                >
                <button type="submit" class="button">{{ 'sections.header.cep_submit' | t }}</button>
              </div>
              <p class="header__cep-error" id="HeaderCepError-{{ section.id }}" role="alert" data-cep-error hidden>
                {{- 'sections.header.cep_error' | t -}}
              </p>
              <p class="header__cep-note">{{ 'sections.header.cep_note' | t }}</p>
              <a class="header__cep-help" href="https://buscacepinter.correios.com.br/" target="_blank" rel="noopener">
                {{- 'sections.header.cep_help' | t -}}
              </a>
            </form>
          </div>
        </details>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="header__info header__account"
        >
          <span class="header__info-icon">{% render 'icon', name: 'account' %}</span>
          <span class="header__info-text">
            <span class="header__info-label">
              {%- if customer -%}
                {%- assign customer_name = customer.first_name | default: customer.email -%}
                {{ 'sections.header.greeting' | t: name: customer_name }}
              {%- else -%}
                {{ 'sections.header.welcome' | t }}
              {%- endif -%}
            </span>
            <span class="header__info-action">
              {%- if customer -%}{{ 'sections.header.my_account' | t }}{%- else -%}{{ 'sections.header.login' | t }}{%- endif -%}
            </span>
          </span>
          <span class="visually-hidden">{{ 'customer.account.title' | t }}</span>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header__cart" aria-label="{{ 'templates.cart.cart' | t }}">
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
    <div class="header__localization">
      {% render 'localization-form',
        section_id: section.id,
        show_country: section.settings.enable_country_selector,
        show_language: section.settings.enable_language_selector
      %}
    </div>
  {%- endif -%}
</header>

{%- if section.settings.show_category_bar -%}
  {{ 'category-bar.css' | asset_url | stylesheet_tag }}
  <nav class="category-bar" aria-label="{{ section.settings.all_categories_label | escape }}">
    <div class="category-bar__inner page-width">
      <details class="category-bar__all" data-popover>
        <summary class="category-bar__all-toggle">
          <svg class="category-bar__all-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          <span class="category-bar__all-label">{{ section.settings.all_categories_label | escape }}</span>
        </summary>
        <div class="category-bar__panel">
          <ul class="category-bar__panel-list" role="list">
            {%- assign has_panel_items = false -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'panel_item' and block.settings.label != blank -%}
                {%- assign has_panel_items = true -%}
                <li {{ block.shopify_attributes }}>
                  <a class="category-bar__panel-link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
                    {% render 'category-icon', name: block.settings.icon, class: 'category-bar__panel-icon' %}
                    <span>{{ block.settings.label | escape }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
            {%- unless has_panel_items -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'link' and block.settings.label != blank -%}
                  <li><a class="category-bar__panel-link" href="{{ block.settings.link | default: routes.all_products_collection_url }}"><span>{{ block.settings.label | escape }}</span></a></li>
                {%- endif -%}
              {%- endfor -%}
            {%- endunless -%}
          </ul>
        </div>
      </details>

      <ul class="category-bar__list" role="list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link' -%}
              <li {{ block.shopify_attributes }}>
                <a
                  class="category-bar__link{% if block.settings.bold %} category-bar__link--bold{% endif %}"
                  href="{{ block.settings.link | default: routes.all_products_collection_url }}"
                  {% if block.settings.link != blank and block.settings.link == request.path %}aria-current="page"{% endif %}
                >
                  {{- block.settings.label | escape -}}
                </a>
              </li>
            {%- when 'divider' -%}
              <li class="category-bar__divider" aria-hidden="true" {{ block.shopify_attributes }}></li>
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    </div>
  </nav>
{%- endif -%}

<div class="header__mobile-nav" id="MobileNav-{{ section.id }}" hidden>
  <ul class="header__mobile-menu" role="list">
    {%- if section.settings.menu.links.size == 0 -%}
      {% render 'menu-fallback', link_class: 'header__mobile-link' %}
    {%- endif -%}
    {%- for link in section.settings.menu.links -%}
      <li>
        <a href="{{ link.url }}" class="header__mobile-link">{{ link.title | escape }}</a>
        {%- if link.links != blank -%}
          <ul role="list" class="header__mobile-submenu">
            {%- for child in link.links -%}
              <li><a href="{{ child.url }}" class="header__mobile-link header__mobile-link--child">{{ child.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label",
      "info": "Usado no menu do celular (botão hambúrguer)."
    },
    {
      "type": "header",
      "content": "Botões ao lado da busca"
    },
    {
      "type": "checkbox",
      "id": "show_support",
      "default": true,
      "label": "Mostrar botão de atendimento"
    },
    {
      "type": "url",
      "id": "support_link",
      "label": "Link do atendimento",
      "info": "Página de contato ou link do WhatsApp. Vazio: /pages/contato."
    },
    {
      "type": "checkbox",
      "id": "show_accessibility",
      "default": true,
      "label": "Mostrar botão de acessibilidade"
    },
    {
      "type": "checkbox",
      "id": "show_cep",
      "default": true,
      "label": "Mostrar \"Informar seu CEP\""
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__localization.content"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.header.settings.enable_country_selector.label"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "t:sections.header.settings.enable_language_selector.label"
    },
    {
      "type": "header",
      "content": "Barra de categorias"
    },
    {
      "type": "checkbox",
      "id": "show_category_bar",
      "default": true,
      "label": "Mostrar barra de categorias abaixo do logo"
    },
    {
      "type": "text",
      "id": "all_categories_label",
      "default": "Todas categorias",
      "label": "Texto do botão de categorias"
    },
    {
      "type": "paragraph",
      "content": "Os itens do painel \"Todas categorias\" são os blocos \"Item de Todas categorias\". Sem nenhum, o painel lista os links da barra."
    }
  ],
  "blocks": [
    {
      "type": "panel_item",
      "name": "Item de Todas categorias",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "Escudo (segurança)" },
            { "value": "wifi", "label": "Wi-Fi (redes)" },
            { "value": "phone", "label": "Telefone (comunicação)" },
            { "value": "keypad", "label": "Teclado (controle de acesso)" },
            { "value": "bolt", "label": "Raio (energia)" },
            { "value": "solar", "label": "Sol e raio (energia solar)" },
            { "value": "home", "label": "Casa (casa inteligente)" },
            { "value": "computer", "label": "Computador (informática)" },
            { "value": "camera", "label": "Câmera" },
            { "value": "lock", "label": "Cadeado" },
            { "value": "network", "label": "Rede" }
          ]
        },
        { "type": "text", "id": "label", "label": "Texto", "default": "Categoria" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "link",
      "name": "Link de categoria",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Categoria" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "bold", "label": "Destacar em negrito", "default": false }
      ]
    },
    {
      "type": "divider",
      "name": "Divisor",
      "settings": []
    }
  ],
  "max_blocks": 24
}
{% endschema %}
