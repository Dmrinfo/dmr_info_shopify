{%- comment -%}
  ============================================================
  MAIN BLOG — listagem de artigos do Blog DMR
  ============================================================

  O QUE FAZ:
  Hero com eyebrow, título e texto; filtro de tags em pílulas
  ("Todos" + cada tag do blog); na primeira página sem filtro, o
  artigo mais recente aparece em destaque (largura total); os demais
  em grade de 3 colunas. Paginação nativa.

  ONDE É USADA:
  Template blog (ex.: /blogs/news). O link "Blog" fica na barra de
  categorias (sections/header-group.json, bloco cat_blog).

  PRINCIPAIS PARTES:
  - snippet 'card-article': card de cada artigo.
  - blog.all_tags / current_tags: filtro por tag (/blogs/<blog>/tagged/<tag>).
  - Settings: eyebrow, text, show_tags, posts_per_page.

  OBSERVAÇÕES:
  CSS em assets/blog.css. Título vem do nome do blog no admin.
{%- endcomment -%}
{{ 'blog.css' | asset_url | stylesheet_tag }}

{%- assign active_tag = current_tags | first -%}

<div class="blog-hero">
  <div class="blog-hero__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="dmr-eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    <h1 class="blog-hero__title">
      {%- if active_tag -%}{{ active_tag | escape }}{%- else -%}{{ blog.title | escape }}{%- endif -%}
    </h1>
    {%- if section.settings.text != blank -%}
      <p class="blog-hero__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
      <nav aria-label="Filtrar artigos por assunto">
        <ul class="blog-tags" role="list">
          <li>
            <a class="blog-tags__link" href="{{ blog.url }}"{% unless active_tag %} aria-current="page"{% endunless %}>Todos</a>
          </li>
          {%- for tag in blog.all_tags -%}
            <li>
              <a
                class="blog-tags__link"
                href="{{ blog.url }}/tagged/{{ tag | handleize }}"
                {% if current_tags contains tag %}aria-current="page"{% endif %}
              >
                {{- tag | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</div>

<section class="blog-list page-width" aria-label="Artigos">
  {%- paginate blog.articles by section.settings.posts_per_page -%}
    {%- if blog.articles.size > 0 -%}
      {%- liquid
        assign show_featured = false
        if paginate.current_page == 1 and active_tag == blank
          assign show_featured = true
        endif
      -%}
      <div class="blog-list__grid">
        {%- for article in blog.articles -%}
          {%- if forloop.first and show_featured -%}
            {% render 'card-article', article: article, featured: true, heading_tag: 'h2', loading: 'eager' %}
          {%- else -%}
            {% render 'card-article', article: article, heading_tag: 'h2' %}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <p class="blog-list__empty">Em breve, novos conteúdos sobre segurança eletrônica, redes e tecnologia.</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Selo acima do título",
      "default": "Blog DMR Info"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto abaixo do título",
      "default": "Dicas, guias e novidades sobre câmeras, alarmes, controle de acesso, redes e informática para proteger e conectar sua casa ou empresa."
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Mostrar filtro por tags",
      "default": true
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 4,
      "max": 25,
      "step": 3,
      "default": 10,
      "label": "t:sections.main_blog.settings.posts_per_page.label",
      "info": "10 = 1 destaque + 9 na grade."
    }
  ]
}
{% endschema %}
