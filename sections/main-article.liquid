{%- comment -%}
  ============================================================
  MAIN ARTICLE — post do Blog DMR
  ============================================================

  O QUE FAZ:
  Artigo completo: breadcrumb (Início / Blog), tag, data, tempo de
  leitura e autor; imagem destacada; conteúdo com tipografia de
  leitura; tags; voltar + compartilhar; CTA azul para falar com a
  equipe; até 3 artigos relacionados (mais recentes do mesmo blog);
  comentários nativos (se ativados no blog).

  ONDE É USADA:
  Template article (post individual OS 2.0).

  PRINCIPAIS PARTES:
  - snippet 'card-article': cards dos relacionados.
  - snippet 'share-button': Web Share API.
  - form 'new_comment': comentários (moderação e erros tratados).
  - Settings: show_related, cta_heading, cta_text, cta_label, cta_link.

  OBSERVAÇÕES:
  CSS em assets/blog.css. Tempo de leitura: 200 palavras por minuto.
{%- endcomment -%}
{{ 'blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign comment_form_id = 'CommentForm-' | append: section.id
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200 | at_least: 1
-%}

<div class="article-hero">
  <div class="article-hero__inner page-width">
    <nav aria-label="Você está em">
      <ol class="article-breadcrumb">
        <li><a href="{{ routes.root_url }}">Início</a></li>
        <li><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li>
      </ol>
    </nav>

    {%- if article.tags.size > 0 -%}
      <span class="dmr-eyebrow">{{ article.tags.first | escape }}</span>
    {%- endif -%}

    <h1 class="article-hero__title">{{ article.title | escape }}</h1>

    <p class="blog-meta">
      {%- if article.published_at -%}
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
        <span class="blog-meta__sep" aria-hidden="true">•</span>
      {%- endif -%}
      <span>{{ minutes }} min de leitura</span>
      {%- if article.author != blank -%}
        <span class="blog-meta__sep" aria-hidden="true">•</span>
        <span>Por {{ article.author | escape }}</span>
      {%- endif -%}
    </p>
  </div>
</div>

<article class="article-body page-width">
  {%- if article.image -%}
    <div class="article-body__media">
      {%- assign img_alt = article.image.alt | default: article.title -%}
      {{
        article.image
        | image_url: width: 1720
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '540, 720, 900, 1200, 1720',
          sizes: '(min-width: 900px) 860px, 100vw',
          class: 'article-body__image',
          alt: img_alt
      }}
    </div>
  {%- endif -%}

  {%- if article.content != blank -%}
    <div class="article-content rte">
      {{ article.content }}
    </div>
  {%- endif -%}

  {%- if article.tags.size > 0 -%}
    <ul class="article-tags" role="list" aria-label="Assuntos">
      {%- for tag in article.tags -%}
        <li><a class="blog-tags__link" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a></li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <div class="article-actions">
    <a href="{{ blog.url }}" class="article-actions__back">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m11 18-6-6 6-6"/></svg>
      {{ 'blogs.article.back_to_blog' | t }}
    </a>
    {% render 'share-button', share_link: article.url, share_title: article.title %}
  </div>

  {%- if section.settings.cta_heading != blank -%}
    <aside class="article-cta" aria-labelledby="ArticleCta-{{ section.id }}">
      <div>
        <h2 class="article-cta__title" id="ArticleCta-{{ section.id }}">{{ section.settings.cta_heading | escape }}</h2>
        {%- if section.settings.cta_text != blank -%}
          <p class="article-cta__text">{{ section.settings.cta_text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        <a class="button" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
          {{- section.settings.cta_label | escape -}}
        </a>
      {%- endif -%}
    </aside>
  {%- endif -%}

  {%- if blog.comments_enabled? -%}
    <div class="article-comments" id="comments">
      {%- if article.comments_count > 0 -%}
        <h2 class="article-comments__title">{{ 'blogs.article.comments' | t: count: article.comments_count }}</h2>
      {%- endif -%}

      {%- paginate article.comments by 5 -%}
        {%- if article.comments_count > 0 -%}
          <ul class="article-comments__list" role="list">
            {%- for comment in article.comments -%}
              <li class="article-comment" id="comment-{{ comment.id }}">
                <div class="rte">{{ comment.content }}</div>
                <cite class="article-comment__meta">
                  {%- assign comment_date = comment.created_at | date: format: 'date' -%}
                  {{ 'blogs.article.comment_meta_html' | t: author: comment.author, date: comment_date }}
                </cite>
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endpaginate -%}

      <h2 class="article-comments__title">{{ 'blogs.article.comment_form_title' | t }}</h2>

      {%- form 'new_comment', article, id: comment_form_id, class: 'comment-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="contact__notice contact__notice--success" role="status" tabindex="-1">
            {%- if blog.moderated? -%}{{ 'blogs.article.success_moderated' | t }}{%- else -%}{{ 'blogs.article.success' | t }}{%- endif -%}
          </div>
        {%- elsif form.errors -%}
          <div class="contact__notice contact__notice--error" role="alert" tabindex="-1">
            <h3 class="contact__notice-title">{{ 'templates.contact.form.error_heading' | t }}</h3>
            <ul class="contact__errors" role="list">
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if blog.moderated? and form.posted_successfully? == false -%}
          <p class="article-comments__note">{{ 'blogs.article.moderated' | t }}</p>
        {%- endif -%}

        <div class="contact__field">
          <label class="field__label" for="CommentForm-author-{{ section.id }}">{{ 'blogs.article.name' | t }}</label>
          <input type="text" class="field__input" id="CommentForm-author-{{ section.id }}" name="comment[author]" value="{{ form.author }}" autocomplete="name" required>
        </div>

        <div class="contact__field">
          <label class="field__label" for="CommentForm-email-{{ section.id }}">{{ 'blogs.article.email' | t }}</label>
          <input type="email" class="field__input" id="CommentForm-email-{{ section.id }}" name="comment[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" spellcheck="false" required>
        </div>

        <div class="contact__field">
          <label class="field__label" for="CommentForm-body-{{ section.id }}">{{ 'blogs.article.message' | t }}</label>
          <textarea rows="6" class="field__input" id="CommentForm-body-{{ section.id }}" name="comment[body]" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="button">{{ 'blogs.article.post' | t }}</button>
      {%- endform -%}
    </div>
  {%- endif -%}
</article>

{%- if section.settings.show_related and blog.articles_count > 1 -%}
  <section class="article-related" aria-labelledby="ArticleRelated-{{ section.id }}">
    <div class="page-width">
      <h2 class="article-related__title" id="ArticleRelated-{{ section.id }}">Continue lendo</h2>
      <div class="blog-list__grid">
        {%- assign related_count = 0 -%}
        {%- for related in blog.articles -%}
          {%- if related.id == article.id -%}{%- continue -%}{%- endif -%}
          {% render 'card-article', article: related, heading_tag: 'h3' %}
          {%- assign related_count = related_count | plus: 1 -%}
          {%- if related_count >= 3 -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_article.name",
  "tag": "section",
  "class": "section-main-article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Mostrar \"Continue lendo\" (3 artigos)",
      "default": true
    },
    {
      "type": "header",
      "content": "Chamada no fim do artigo"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Título",
      "default": "Precisa de ajuda para escolher?",
      "info": "Vazio: a chamada não aparece."
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "Texto",
      "default": "Nossa equipe monta a solução ideal de segurança e tecnologia para a sua casa ou empresa."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto do botão",
      "default": "Falar com especialista"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link do botão",
      "info": "Página de contato ou link do WhatsApp."
    }
  ]
}
{% endschema %}
