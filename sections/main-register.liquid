{%- comment -%}
  ============================================================
  main-register — página "Criar conta" (customers/register)
  ============================================================

  O QUE FAZ:
  Formulário de cadastro: nome, sobrenome, e-mail, senha e opt-in de
  e-mail marketing.

  OBSERVACOES:
  Só é usado com contas de cliente clássicas.
{%- endcomment -%}
{{ 'customer.css' | asset_url | stylesheet_tag }}

<section class="customer customer--narrow page-width">
  <h1 class="customer__title">{{ 'customer.register.title' | t }}</h1>
  <p class="customer__lead">{{ 'customer.register.lead' | t }}</p>

  <div class="customer__card">
    {%- form 'create_customer', class: 'customer__form', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="customer__errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="customer__row">
        <div class="customer__field">
          <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input class="field__input" type="text" id="RegisterFirstName" name="customer[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name">
        </div>
        <div class="customer__field">
          <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input class="field__input" type="text" id="RegisterLastName" name="customer[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name">
        </div>
      </div>
      <div class="customer__field">
        <label class="field__label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
        <input class="field__input" type="email" id="RegisterEmail" name="customer[email]" value="{{ form.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required>
      </div>
      <div class="customer__field">
        <label class="field__label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
        <input class="field__input" type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <label class="customer__checkbox">
        <input type="checkbox" name="customer[accepts_marketing]" value="true">
        <span>{{ 'customer.register.accepts_marketing' | t }}</span>
      </label>
      <button type="submit" class="button customer__submit">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}

    <div class="customer__links">
      <span>{{ 'customer.register.have_account' | t }}</span>
      <a class="customer__link" href="{{ routes.account_login_url }}">{{ 'customer.register.sign_in' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Criar conta",
  "settings": []
}
{% endschema %}
