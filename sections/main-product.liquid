{%- comment -%}
  ============================================================
  MAIN PRODUCT — página de produto (Shopify OS 2.0)
  ============================================================

  O QUE FAZ:
  Topo da página de produto no modelo da loja Intelbras: trilha
  (Início › coleção › produto), galeria com setas e miniaturas à
  esquerda e, à direita, título, código, etiquetas, preço De/Por com
  PIX, parcelas e "Ver formas de pagamento", opções e os botões
  "Comprar agora" e "Adicionar ao carrinho".

  ONDE É USADA:
  templates/product.json (seguida de 'product-details' e
  'related-products').

  PRINCIPAIS PARTES:
  - Galeria: lista com scroll-snap (#ProductMedia-{section.id}); as
    setas e as miniaturas são controladas por assets/product.js.
  - {% form 'product' %}: input hidden da variante atual. "Comprar
    agora" é um submit com name="return_to" = /checkout (data-buy-now:
    carrinho.js não intercepta); "Adicionar ao carrinho" segue por
    AJAX (carrinho.js).
  - Blocos: title, sku, badges, vendor, price, variant_picker,
    quantity, buy_buttons, description, share, custom_liquid e @app.
  - variant_picker gera <script data-variant-json> com id, opções,
    disponibilidade, mídia, SKU e o HTML do preço de cada variante.

  OBSERVAÇÕES:
  - Preço vem do snippet 'card-price' com labels: true (De/Por, PIX,
    parcelas e quadro de formas de pagamento).
  - CSS em assets/product.css; JS em assets/product.js. Textos do JS
    vão em data-* do <form> (data-add-text etc.).
  - Frete por CEP não é calculado aqui: o Shopify só cota frete no
    carrinho/checkout. Um app de frete pode entrar como bloco @app.
{%- endcomment -%}
{{ 'product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign checkout_url = routes.root_url | append: 'checkout' | replace: '//', '/'
  assign add_text = 'products.page.add_to_cart' | t
  assign sold_out_text = 'products.product.sold_out' | t
  assign unavailable_text = 'products.product.unavailable' | t

  assign crumb_collection = collection
  if crumb_collection == blank
    for item in product.collections
      unless item.handle == 'all' or item.handle == 'frontpage'
        assign crumb_collection = item
        break
      endunless
    endfor
  endif
-%}

<section class="product page-width" data-section-id="{{ section.id }}" data-product-section>
  <nav class="breadcrumbs" aria-label="{{ 'products.page.breadcrumb' | t }}">
    <ol class="breadcrumbs__list" role="list">
      <li class="breadcrumbs__item"><a class="breadcrumbs__link" href="{{ routes.root_url }}">{{ 'products.page.home' | t }}</a></li>
      {%- if crumb_collection != blank -%}
        <li class="breadcrumbs__item"><a class="breadcrumbs__link" href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a></li>
      {%- endif -%}
      <li class="breadcrumbs__item"><span class="breadcrumbs__current" aria-current="page">{{ product.title | escape }}</span></li>
    </ol>
  </nav>

  <div class="product__grid">
    <div class="product__gallery" data-product-gallery>
      <div class="product__viewer">
        {%- if product.media.size > 0 -%}
          <ul class="product__slides" id="ProductMedia-{{ section.id }}" role="list">
            {%- for media in product.media -%}
              <li class="product__slide" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {%- liquid
                      assign img_alt = media.alt | default: product.title
                      assign img_loading = 'lazy'
                      assign img_priority = 'auto'
                      if forloop.first
                        assign img_loading = 'eager'
                        assign img_priority = 'high'
                      endif
                    -%}
                    {{
                      media
                      | image_url: width: 1400
                      | image_tag:
                        loading: img_loading,
                        fetchpriority: img_priority,
                        sizes: '(min-width: 1000px) 50vw, 100vw',
                        widths: '360, 540, 720, 900, 1100, 1400',
                        alt: img_alt
                    }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag }}
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, image_size: '1400x' }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag }}
                  {%- else -%}
                    {{ media | media_tag }}
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>
          {%- if product.media.size > 1 -%}
            <button type="button" class="product__viewer-nav product__viewer-nav--prev" data-gallery-prev aria-label="{{ 'products.page.gallery_previous' | t }}" disabled>
              {% render 'icon', name: 'chevron-right', class: 'product__viewer-icon' %}
            </button>
            <button type="button" class="product__viewer-nav product__viewer-nav--next" data-gallery-next aria-label="{{ 'products.page.gallery_next' | t }}">
              {% render 'icon', name: 'chevron-right', class: 'product__viewer-icon' %}
            </button>
          {%- endif -%}
        {%- else -%}
          <div class="product__slide product__slide--placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <ul class="product__thumbs" role="list">
          {%- for media in product.media -%}
            <li>
              <button
                type="button"
                class="product__thumb"
                data-gallery-thumb="{{ forloop.index0 }}"
                aria-label="{{ 'products.page.gallery_thumbnail' | t: index: forloop.index }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              >
                {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- form 'product',
        product,
        id: product_form_id,
        class: 'product__form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form',
        data-add-text: add_text,
        data-sold-out-text: sold_out_text,
        data-unavailable-text: unavailable_text
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ current_variant.id }}"
          {% if current_variant.available == false %}disabled{% endif %}
          class="product-variant-id"
        >

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'sku' -%}
              <p class="product__sku" data-product-sku {% if current_variant.sku == blank %}hidden{% endif %} {{ block.shopify_attributes }}>
                {{- 'products.page.sku' | t: sku: current_variant.sku -}}
              </p>

            {%- when 'badges' -%}
              <div class="product__badges" {{ block.shopify_attributes }}>
                {% render 'product-badges', product: product %}
              </div>

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                {% render 'card-price', product: product, variant: current_variant, labels: true %}
                {%- if current_variant.unit_price_measurement -%}
                  <div class="product__unit-price">
                    {{ current_variant.unit_price | money }}
                    <span aria-hidden="true">/</span>
                    {%- if current_variant.unit_price_measurement.reference_value != 1 -%}
                      {{ current_variant.unit_price_measurement.reference_value }}
                    {%- endif -%}
                    {{ current_variant.unit_price_measurement.reference_unit }}
                  </div>
                {%- endif -%}
                {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                  <div class="product__tax">
                    {%- if cart.taxes_included -%}
                      {{ 'products.product.include_taxes' | t }}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="product__variants" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="product__option">
                      <legend class="product__option-name">{{ option.name }}</legend>
                      {%- for value in option.values -%}
                        {%- liquid
                          assign option_disabled = true
                          for variant in product.variants
                            if variant.available and variant.options[forloop.parentloop.index0] == value
                              assign option_disabled = false
                              break
                            endif
                          endfor
                        -%}
                        <label class="product__swatch {% if option.selected_value == value %}is-selected{% endif %} {% if option_disabled %}is-unavailable{% endif %}">
                          <input
                            type="radio"
                            name="{{ option.name }}"
                            value="{{ value | escape }}"
                            class="visually-hidden"
                            {% if option.selected_value == value %}checked{% endif %}
                            data-option-index="{{ forloop.parentloop.index0 }}"
                          >
                          {%- if value.swatch.image -%}
                            <span class="product__swatch-media" style="background-image:url({{ value.swatch.image | image_url: width: 100 }})"></span>
                          {%- elsif value.swatch.color -%}
                            <span class="product__swatch-color" style="background-color:{{ value.swatch.color }}"></span>
                          {%- else -%}
                            <span class="product__swatch-label">{{ value }}</span>
                          {%- endif -%}
                        </label>
                      {%- endfor -%}
                    </fieldset>
                  {%- endfor -%}
                </div>

                <script type="application/json" data-variant-json>
                  [
                    {%- for variant in product.variants -%}
                      {%- capture variant_price_html -%}{% render 'card-price', product: product, variant: variant, labels: true %}{%- endcapture -%}
                      {%- assign variant_sku_text = '' -%}
                      {%- if variant.sku != blank -%}
                        {%- assign variant_sku_text = 'products.page.sku' | t: sku: variant.sku -%}
                      {%- endif -%}
                      {
                        "id": {{ variant.id | json }},
                        "options": {{ variant.options | json }},
                        "available": {{ variant.available | json }},
                        "featured_media_id": {{ variant.featured_media.id | json }},
                        "sku_text": {{ variant_sku_text | json }},
                        "price_html": {{ variant_price_html | strip_newlines | json }}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                </script>
              {%- endunless -%}

            {%- when 'quantity' -%}
              <div class="product__quantity" {{ block.shopify_attributes }}>
                <label class="field__label" for="Quantity-{{ section.id }}">
                  {{ 'products.product.quantity.label' | t }}
                </label>
                <div class="quantity-selector">
                  <button type="button" class="quantity__button" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">&minus;</button>
                  <input
                    class="quantity__input"
                    type="number"
                    name="quantity"
                    id="Quantity-{{ section.id }}"
                    min="1"
                    value="1"
                    aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}"
                  >
                  <button type="button" class="quantity__button" name="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">&plus;</button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product__buy-buttons" {{ block.shopify_attributes }}>
                {%- if block.settings.show_buy_now -%}
                  <button
                    type="submit"
                    name="return_to"
                    value="{{ checkout_url }}"
                    class="button product__buy-now"
                    data-buy-now
                    {% if current_variant.available == false %}disabled{% endif %}
                  >
                    {{- 'products.card.buy_now' | t -}}
                  </button>
                {%- endif -%}
                <button
                  type="submit"
                  name="add"
                  class="button button--secondary product__add-to-cart"
                  {% if current_variant.available == false %}disabled{% endif %}
                >
                  {% render 'icon', name: 'cart', class: 'product__add-to-cart-icon' %}
                  <span>
                    {%- if current_variant.available -%}
                      {{ add_text }}
                    {%- else -%}
                      {{ sold_out_text }}
                    {%- endif -%}
                  </span>
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              </div>

            {%- when 'share' -%}
              <div class="product__share" {{ block.shopify_attributes }}>
                {% render 'share-button', share_link: product.url, share_title: product.title %}
              </div>

            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- endcase -%}
        {%- endfor -%}
      {%- endform -%}
    </div>
  </div>
</section>

<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "t:sections.main_product.blocks.title.name", "limit": 1 },
    { "type": "sku", "name": "Código do produto", "limit": 1 },
    { "type": "badges", "name": "Etiquetas (Frete Grátis)", "limit": 1 },
    { "type": "vendor", "name": "t:sections.main_product.blocks.vendor.name", "limit": 1 },
    { "type": "price", "name": "t:sections.main_product.blocks.price.name", "limit": 1 },
    { "type": "variant_picker", "name": "t:sections.main_product.blocks.variant_picker.name", "limit": 1 },
    { "type": "quantity", "name": "t:sections.main_product.blocks.quantity.name", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_buy_now",
          "default": true,
          "label": "Mostrar \"Comprar agora\"",
          "info": "Adiciona o produto e leva direto ao checkout."
        },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": false,
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "info": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.info"
        }
      ]
    },
    { "type": "description", "name": "t:sections.main_product.blocks.description.name", "limit": 1 },
    { "type": "share", "name": "t:sections.main_product.blocks.share.name", "limit": 1 },
    {
      "type": "custom_liquid",
      "name": "t:sections.main_product.blocks.custom_liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.main_product.blocks.custom_liquid.settings.custom_liquid.label"
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "t:sections.main_product.name",
      "blocks": [
        { "type": "title" },
        { "type": "sku" },
        { "type": "badges" },
        { "type": "price" },
        { "type": "variant_picker" },
        { "type": "buy_buttons" }
      ]
    }
  ]
}
{% endschema %}
