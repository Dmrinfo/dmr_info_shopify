{%- comment -%}
  ============================================================
  banner-carousel — carrossel de banners (sem botões)
  ============================================================

  O QUE FAZ:
  Exibe uma sequência de banners em carrossel com rolagem suave,
  setas, pontos de navegação e troca automática opcional. Cada slide
  tem imagem (desktop e mobile), texto opcional e um link opcional —
  quando há link, o banner inteiro é clicável (não há botões).

  COMO USAR:
  Adicione a seção "Carrossel de banners" na home pelo editor de temas
  e inclua slides (blocos). Máximo de 6 slides.

  PARÂMETROS (schema):
  - autoplay / autoplay_seconds: troca automática e intervalo.
  - height: altura do banner (pequena, média, grande).
  - Bloco slide: image, mobile_image, link, heading, text, text_alignment.

  OBSERVACOES:
  Slide sem imagem usa o gradiente da marca (--dmr-gradient-linear).
  Autoplay pausa no hover/foco e é desativado com prefers-reduced-motion.
  CSS em assets/banner-carousel.css, JS em assets/banner-carousel.js.
{%- endcomment -%}
{{ 'banner-carousel.css' | asset_url | stylesheet_tag }}

<section
  class="banner-carousel banner-carousel--{{ section.settings.height }}"
  data-banner-carousel
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_seconds | times: 1000 }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div class="banner-carousel__track" data-track tabindex="0">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tag = 'div'
        if block.settings.link != blank
          assign tag = 'a'
        endif
      -%}
      <{{ tag }}
        class="banner-carousel__slide banner-carousel__slide--{{ block.settings.text_alignment }}"
        data-slide
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} / {{ forloop.length }}"
        {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          <picture class="banner-carousel__media">
            {%- if block.settings.mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ block.settings.mobile_image | image_url: width: 750 }} 750w, {{ block.settings.mobile_image | image_url: width: 1100 }} 1100w"
                sizes="100vw"
              >
            {%- endif -%}
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                class: 'banner-carousel__image',
                widths: '750, 1100, 1500, 1920, 2400',
                sizes: '100vw',
                loading: forloop.first | ternary: 'eager', 'lazy',
                fetchpriority: forloop.first | ternary: 'high', 'auto',
                alt: block.settings.image.alt | default: block.settings.heading | escape
            }}
          </picture>
        {%- endif -%}

        {%- if block.settings.heading != blank or block.settings.text != blank -%}
          <div class="banner-carousel__content page-width">
            <div class="banner-carousel__box">
              {%- if block.settings.heading != blank -%}
                <h2 class="banner-carousel__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="banner-carousel__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </{{ tag }}>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button type="button" class="banner-carousel__arrow banner-carousel__arrow--prev" data-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
    </button>
    <button type="button" class="banner-carousel__arrow banner-carousel__arrow--next" data-next aria-label="{{ 'accessibility.next_slide' | t }}">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
    </button>

    <div class="banner-carousel__dots" data-dots>
      {%- for block in section.blocks -%}
        <button type="button" class="banner-carousel__dot" data-dot="{{ forloop.index0 }}" aria-label="{{ forloop.index }} / {{ forloop.length }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script src="{{ 'banner-carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Carrossel de banners",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Descrição para leitores de tela",
      "default": "Destaques da loja"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Altura do banner",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Pequena" },
        { "value": "medium", "label": "Média" },
        { "value": "large", "label": "Grande" }
      ]
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Trocar slides automaticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Intervalo entre slides",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem (desktop)", "info": "Recomendado: 2400 x 900 px." },
        { "type": "image_picker", "id": "mobile_image", "label": "Imagem (mobile)", "info": "Recomendado: 750 x 900 px. Se vazio, usa a imagem do desktop." },
        { "type": "url", "id": "link", "label": "Link do banner", "info": "O banner inteiro vira clicável. Deixe vazio para não ter link." },
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "richtext", "id": "text", "label": "Texto" },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Alinhamento do texto",
          "default": "left",
          "options": [
            { "value": "left", "label": "Esquerda" },
            { "value": "center", "label": "Centro" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carrossel de banners",
      "blocks": [
        { "type": "slide", "settings": { "heading": "Segurança eletrônica para o seu negócio" } },
        { "type": "slide", "settings": { "heading": "Informática e redes para o seu negócio" } }
      ]
    }
  ]
}
{% endschema %}
