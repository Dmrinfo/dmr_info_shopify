{%- comment -%}
  ============================================================
  COLLECTION BANNER — topo da página de coleção
  ============================================================

  O QUE FAZ:
  Título da coleção e banner arredondado com a imagem da coleção
  (cadastrada em Produtos → Coleções → Imagem). Descrição opcional.

  ONDE É USADA:
  templates/collection.json, acima da section main-collection.

  OBSERVAÇÕES:
  - Sem imagem, nada aparece no lugar do banner na loja; no editor de
    tema aparece um aviso de como adicionar.
  - Tamanho recomendado da imagem: 2400 × 600 px.
  - Estilos em assets/collection.css.
{%- endcomment -%}
{{ 'collection.css' | asset_url | stylesheet_tag }}

<div class="collection-hero page-width">
  <h1 class="collection-hero__title">{{ collection.title | escape }}</h1>

  {%- if section.settings.show_image and collection.image -%}
    {%- assign banner_alt = collection.image.alt | default: collection.title -%}
    <div class="collection-hero__banner">
      {{
        collection.image
        | image_url: width: 2400
        | image_tag:
          class: 'collection-hero__image',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1920, 2400',
          sizes: '(min-width: 1320px) 1280px, 100vw',
          alt: banner_alt
      }}
    </div>
  {%- elsif section.settings.show_image and request.design_mode -%}
    <div class="collection-hero__placeholder">{{ 'sections.collection_banner.placeholder' | t }}</div>
  {%- endif -%}

  {%- if section.settings.show_description and collection.description != blank -%}
    <div class="collection-hero__description rte">{{ collection.description }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.collection_banner.name",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.collection_banner.settings.show_image.label",
      "info": "Usa a imagem da coleção como banner. Recomendado: 2400 × 600 px."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": false,
      "label": "t:sections.collection_banner.settings.show_description.label"
    }
  ]
}
{% endschema %}
