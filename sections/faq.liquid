{%- comment -%}
  ============================================================
  faq — perguntas frequentes (acordeão)
  ============================================================

  O QUE FAZ:
  Lista perguntas e respostas em acordeão acessível, usando
  <details>/<summary> nativos (funciona sem JavaScript). Também
  emite JSON-LD FAQPage para o Google.

  COMO USAR:
  Adicione "Perguntas frequentes" e inclua blocos "Pergunta".
  Máximo de 12.

  PARÂMETROS (schema):
  - eyebrow, heading: texto acima da lista.
  - Bloco question: question, answer (texto rico).

  OBSERVACOES:
  Estilo no <style> abaixo, escopado por .faq.
{%- endcomment -%}
<section class="faq page-width">
  {%- if section.settings.eyebrow != blank -%}
    <span class="dmr-eyebrow">{{ section.settings.eyebrow | escape }}</span>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="faq__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="faq__list">
    {%- for block in section.blocks -%}
      <details class="faq__item" {{ block.shopify_attributes }}>
        <summary class="faq__question">
          <span>{{ block.settings.question | escape }}</span>
          <svg class="faq__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="faq__answer rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<style>
  .faq { max-width: 860px; padding-top: var(--spacing-sections); padding-bottom: var(--spacing-sections); }
  .faq__heading { margin: 16px 0 32px; }
  .faq__list { display: flex; flex-direction: column; gap: 12px; }
  .faq__item {
    background: var(--dmr-alice-blue);
    border: 1px solid var(--dmr-azureish-white);
    border-radius: var(--dmr-radius-lg);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .faq__item[open] { border-color: var(--dmr-diamond); box-shadow: var(--dmr-shadow-subtle); }
  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding: 18px 24px;
    font-family: var(--font-heading-family);
    font-size: var(--f3);
    letter-spacing: var(--dmr-title-tracking);
    color: var(--dmr-eerie-black);
    cursor: pointer;
    list-style: none;
  }
  .faq__question::-webkit-details-marker { display: none; }
  .faq__chevron { flex: none; color: var(--dmr-primary); transition: transform 0.2s ease; }
  .faq__item[open] .faq__chevron { transform: rotate(180deg); }
  .faq__answer { padding: 0 24px 22px; font-size: var(--f2); line-height: 1.6; color: var(--dmr-independence); }
  @media (prefers-reduced-motion: reduce) {
    .faq__chevron, .faq__item { transition: none; }
  }
</style>

{% schema %}
{
  "name": "Perguntas frequentes",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Dúvidas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Perguntas frequentes" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pergunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pergunta", "default": "Como solicito um orçamento?" },
        { "type": "richtext", "id": "answer", "label": "Resposta", "default": "<p>Escreva aqui a resposta.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perguntas frequentes",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "Os produtos têm garantia e nota fiscal?" } },
        { "type": "question", "settings": { "question": "Qual o prazo de entrega?" } }
      ]
    }
  ]
}
{% endschema %}
