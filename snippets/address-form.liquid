{%- comment -%}
  ============================================================
  address-form — campos do formulário de endereço do cliente
  ============================================================

  O QUE FAZ:
  Renderiza os campos de um endereço (nome, empresa, rua, complemento,
  cidade, CEP, país, estado, telefone, endereço principal) e o botão
  de salvar, dentro de um {% form 'customer_address' %}.

  COMO USAR:
  {%- form 'customer_address', customer.new_address -%}
    {% render 'address-form', form: form, id: 'new' %}
  {%- endform -%}

  PARÂMETROS:
  - form: objeto form da tag {% form 'customer_address' %}.
  - id: sufixo único dos ids ('new' ou address.id).

  OBSERVACOES:
  País e estado usam Shopify.CountryProvinceSelector (shopify_common.js),
  inicializado em sections/main-addresses.liquid via [data-address-country].
  Novo endereço vem com o país Brasil selecionado.
{%- endcomment -%}
{%- if form.errors -%}
  <div class="customer__errors" role="alert">{{ form.errors | default_errors }}</div>
{%- endif -%}

<div class="customer__row">
  <div class="customer__field">
    <label class="field__label" for="AddressFirstName_{{ id }}">{{ 'customer.addresses.first_name' | t }}</label>
    <input class="field__input" type="text" id="AddressFirstName_{{ id }}" name="address[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name">
  </div>
  <div class="customer__field">
    <label class="field__label" for="AddressLastName_{{ id }}">{{ 'customer.addresses.last_name' | t }}</label>
    <input class="field__input" type="text" id="AddressLastName_{{ id }}" name="address[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name">
  </div>
</div>

<div class="customer__field">
  <label class="field__label" for="AddressCompany_{{ id }}">{{ 'customer.addresses.company' | t }}</label>
  <input class="field__input" type="text" id="AddressCompany_{{ id }}" name="address[company]" value="{{ form.company | escape }}" autocomplete="organization">
</div>

<div class="customer__field">
  <label class="field__label" for="AddressAddress1_{{ id }}">{{ 'customer.addresses.address1' | t }}</label>
  <input class="field__input" type="text" id="AddressAddress1_{{ id }}" name="address[address1]" value="{{ form.address1 | escape }}" autocomplete="address-line1">
</div>

<div class="customer__field">
  <label class="field__label" for="AddressAddress2_{{ id }}">{{ 'customer.addresses.address2' | t }}</label>
  <input class="field__input" type="text" id="AddressAddress2_{{ id }}" name="address[address2]" value="{{ form.address2 | escape }}" autocomplete="address-line2">
</div>

<div class="customer__row">
  <div class="customer__field">
    <label class="field__label" for="AddressCity_{{ id }}">{{ 'customer.addresses.city' | t }}</label>
    <input class="field__input" type="text" id="AddressCity_{{ id }}" name="address[city]" value="{{ form.city | escape }}" autocomplete="address-level2">
  </div>
  <div class="customer__field">
    <label class="field__label" for="AddressZip_{{ id }}">{{ 'customer.addresses.zip' | t }}</label>
    <input class="field__input" type="text" id="AddressZip_{{ id }}" name="address[zip]" value="{{ form.zip | escape }}" autocomplete="postal-code" inputmode="numeric">
  </div>
</div>

<div class="customer__row">
  <div class="customer__field">
    <label class="field__label" for="AddressCountry_{{ id }}">{{ 'customer.addresses.country' | t }}</label>
    <select
      class="field__input"
      id="AddressCountry_{{ id }}"
      name="address[country]"
      autocomplete="country"
      data-default="{{ form.country | default: 'Brazil' | escape }}"
      data-address-country
      data-province-id="AddressProvince_{{ id }}"
      data-province-container="AddressProvinceContainer_{{ id }}"
    >
      {{ all_country_option_tags }}
    </select>
  </div>
  <div class="customer__field" id="AddressProvinceContainer_{{ id }}">
    <label class="field__label" for="AddressProvince_{{ id }}">{{ 'customer.addresses.province' | t }}</label>
    <select
      class="field__input"
      id="AddressProvince_{{ id }}"
      name="address[province]"
      autocomplete="address-level1"
      data-default="{{ form.province | escape }}"
    ></select>
  </div>
</div>

<div class="customer__field">
  <label class="field__label" for="AddressPhone_{{ id }}">{{ 'customer.addresses.phone' | t }}</label>
  <input class="field__input" type="tel" id="AddressPhone_{{ id }}" name="address[phone]" value="{{ form.phone | escape }}" autocomplete="tel">
</div>

<label class="customer__checkbox">
  {{ form.set_as_default_checkbox }}
  <span>{{ 'customer.addresses.set_default' | t }}</span>
</label>

<button type="submit" class="button customer__submit">
  {%- if id == 'new' -%}{{ 'customer.addresses.save' | t }}{%- else -%}{{ 'customer.addresses.update' | t }}{%- endif -%}
</button>
