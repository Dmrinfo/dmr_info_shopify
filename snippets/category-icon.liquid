{%- comment -%}
  ============================================================
  category-icon — ícones de linha para categorias da loja
  ============================================================

  O QUE FAZ:
  Renderiza um SVG (24x24, traço) para a categoria pedida. Herda a
  cor do texto (currentColor). Desenhos da Tabler Icons (MIT), a mesma
  biblioteca do site dmrinfo.com.br.

  COMO USAR:
  {% render 'category-icon', name: 'shield', class: 'minha-classe' %}

  PARÂMETROS:
  - name: shield, wifi, phone, keypad, bolt, solar, home, camera, lock, network, recorder, alarm, fence, intercom, computer.
    Valor desconhecido usa 'computer'.
  - class: classe CSS do <svg> (opcional).

  OBSERVACOES:
  Usado em sections/nav.liquid (painel "Todas categorias"),
  sections/category-cards.liquid e sections/category-circles.liquid.
  Tabler: shield-check, wifi, device-landline-phone, fingerprint, bolt,
  solar-panel, smart-home, device-cctv, lock, network, server, urgent,
  fence, bell-ringing e device-desktop (padrão).
{%- endcomment -%}
<svg{% if class != blank %} class="{{ class }}"{% endif %} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'shield' -%}
      <path d="M11.46 20.846a12 12 0 0 1 -7.96 -14.846a12 12 0 0 0 8.5 -3a12 12 0 0 0 8.5 3a12 12 0 0 1 -.09 7.06"/><path d="M15 19l2 2l4 -4"/>
    {%- when 'wifi' -%}
      <path d="M12 18l.01 0"/><path d="M9.172 15.172a4 4 0 0 1 5.656 0"/><path d="M6.343 12.343a8 8 0 0 1 11.314 0"/><path d="M3.515 9.515c4.686 -4.687 12.284 -4.687 17 0"/>
    {%- when 'phone' -%}
      <path d="M20 3h-2a2 2 0 0 0 -2 2v14a2 2 0 0 0 2 2h2a2 2 0 0 0 2 -2v-14a2 2 0 0 0 -2 -2"/><path d="M16 4h-11a3 3 0 0 0 -3 3v10a3 3 0 0 0 3 3h11"/><path d="M12 8h-6v3h6l0 -3"/><path d="M12 14v.01"/><path d="M9 14v.01"/><path d="M6 14v.01"/><path d="M12 17v.01"/><path d="M9 17v.01"/><path d="M6 17v.01"/>
    {%- when 'keypad' -%}
