{%- comment -%}
  ============================================================
  product-carousel-track — faixa de cards com setas e bolinhas
  ============================================================

  O QUE FAZ:
  Lista de cards (snippet 'card-product') que rola na horizontal com
  scroll-snap, mais os controles embaixo: seta anterior, bolinhas
  (geradas pelo JS, uma por página) e seta seguinte.

  COMO USAR:
  {% render 'product-carousel-track', products: collection.products, limit: 12, prev_label: 'Anterior', next_label: 'Próximo' %}

  PARÂMETROS:
  - products: lista de produtos.
  - limit: máximo de produtos.
  - prev_label, next_label: textos acessíveis das setas.

  OBSERVACOES:
  Usado só em sections/product-carousel.liquid. Comportamento em
  assets/product-carousel.js; estilo em assets/product-carousel.css.
{%- endcomment -%}
<ul class="product-carousel__track" role="list" data-carousel-track>
  {%- for product in products limit: limit -%}
    <li class="product-carousel__item">{% render 'card-product', card_product: product %}</li>
  {%- endfor -%}
</ul>
<div class="product-carousel__controls" data-carousel-controls>
  <button type="button" class="product-carousel__arrow product-carousel__arrow--prev" data-carousel-prev aria-label="{{ prev_label | escape }}" disabled>
    {% render 'icon', name: 'chevron-right', class: 'product-carousel__arrow-icon' %}
  </button>
  <div class="product-carousel__dots" data-carousel-dots data-dot-label="{{ 'sections.product_carousel.page' | t }}"></div>
  <button type="button" class="product-carousel__arrow product-carousel__arrow--next" data-carousel-next aria-label="{{ next_label | escape }}">
    {% render 'icon', name: 'chevron-right', class: 'product-carousel__arrow-icon' %}
  </button>
</div>
